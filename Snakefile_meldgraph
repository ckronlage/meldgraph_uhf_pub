def get_subj_ids_copy(wildcards):
    if wildcards.site == '7T_rory':
        checkpoints.copy_7T_rory_meld_graph.get(**wildcards).output[0]
    elif wildcards.site == 'RICE':
        checkpoints.copy_RICE_meld_graph.get(**wildcards).output[0]
    elif wildcards.site == 'bonn_7T':
        checkpoints.copy_bonn_7T_meld_graph.get(**wildcards).output[0]
    elif wildcards.site == 'cambridge':
        checkpoints.copy_cambridge_meld_graph.get(**wildcards).output[0]
    dir = f'data/meld_graph/{wildcards.site}/{wildcards.B0}/input/'
    return [f for f in os.listdir(dir) if f.startswith('sub-')]

rule meld_graph_segmentation:
    input:
        'data/meld_graph/{site}/{B0}/input/',
        expand('data/meld_graph/{{site}}/{{B0}}/output/fs_outputs/{subj_id}/', subj_id=get_subj_ids_copy),
        expand('data/meld_graph/{{site}}/{{B0}}/output/fs_outputs/{subj_id}/surf_meld/', subj_id=get_subj_ids_copy),
        expand('data/meld_graph/{{site}}/{{B0}}/output/fs_outputs/{subj_id}/scripts/recon-all.done', subj_id=get_subj_ids_copy)
    output:
        'data/meld_graph/{site}/{B0}/.segmentation.done'
    localrule: True
    shell:
        """
        date > {output}
        """
    
checkpoint meld_graph_preprocessing:
    input:
        'data/meld_graph/{site}/{B0}/.segmentation.done'
    output:
        'data/meld_graph/{site}/{B0}/.preprocessing.done'
    threads: 2
    shell:
        # - need to use new_pt_pipeline.py here instead of run_script_preprocessing.py because we
        #    need to re-run the feature extraction for all subjects into .hdf5 files 
        # - also use the --skip_prediction flag instead of --harmo_only because the
        #   latter disables some feature extraction steps that are need for predictions
        r"""
        rm -rf data/meld_graph/{wildcards.site}/{wildcards.B0}/output/preprocessed_surf_data
        rm -rf data/meld_graph/{wildcards.site}/{wildcards.B0}/output/predictions_reports
        rm -rf data/meld_graph/{wildcards.site}/{wildcards.B0}/output/classifier_outputs
        export APPTAINER_BINDPATH=data/meld_graph/{wildcards.site}/{wildcards.B0}/:/data,license.txt:/license.txt:ro,meld_license.txt:/meld_license.txt:ro
        export APPTAINERENV_FS_LICENSE=/license.txt
        export APPTAINERENV_MELD_LICENSE=/meld_license.txt
        RULE_TMPDIR="$(mktemp -d $TMPDIR/snakemake-apptainer.XXXXXX)"
        cleanup() {{
           rm -rf "$RULE_TMPDIR"
        }}
        trap cleanup EXIT INT TERM
        export APPTAINER_BINDPATH=$APPTAINER_BINDPATH,$RULE_TMPDIR:/tmp
        apptainer exec --containall meld_graph.sif /bin/bash -c "cd /app && source \$FREESURFER_HOME/FreeSurferEnv.sh && python scripts/new_patient_pipeline/new_pt_pipeline.py -ids input/subjects_list.txt --harmo_code UHF -demos input/demographics_file.csv --skip_prediction --skip_feature_plotting"
        date > {output}
        """

rule meld_graph_prediction_persubj:
    input:
        'data/meld_graph/{site}/{B0}/output/fs_outputs/{subj_id}/scripts/recon-all.done',
