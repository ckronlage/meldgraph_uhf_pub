
# MELD-graph pipeline for the UHF MELD project.
#
# Run with:  snakemake -s Snakefile_meldgraph [--profile profiles/snakemake_profile_csd3]
#
# Folder layout under data/:
#   meld_graph_scaffold/          the MELD data folder downloaded once by prepare_classifier.py
#                                 (meld_params/ incl. distributed_combat/, models/); no subject data
#
#   meld_graph/<site>/<B0>/       input/ + the FreeSurfer segmentation outputs
#                                 (output/fs_outputs) + the harmonised predictions.
#                                 meld_params/ and models/ are from the scaffold.
#
#   meld_graph_noharmo/<site>/<B0>/  hardlinked copy of the above + unharmonised predictions
#

# set shell prefix from config if exists
if 'shell_prefix' in config.keys():
    default = 'set -euo pipefail;\n'
    shell.prefix(config['shell_prefix'] + '; ' + default)
else:
    shell.prefix('set -euo pipefail;\nAPPTAINER_BINDPATH=""')

wildcard_constraints:
    # site doesn't contain slashes
    site="[^/]+",
    # field strength / acquisition condition
    B0="3T|3T_fastsurfer|3T_FLAIR|7T|7T_fastsurfer|7T_nouhf|7T_FLAIR|7T_CP|7T_CP_nouhf|7T_CP_FLAIR|7T_pTx|7T_pTx_nouhf|7T_pTx_FLAIR"

rule download_meld_graph_scaffold:
    # download the MELD data (meld_params/, models/) once into data/meld_graph_scaffold/;
    # every data/meld_graph/<site>/<B0>/ gets a copy of it from create_meld_graph_folder
    output:
        'data/meld_graph_scaffold/.download.done'
    localrule: True
    shell:
        r"""
        rm -rf data/meld_graph_scaffold/
        mkdir -p data/meld_graph_scaffold/
        export APPTAINER_BINDPATH=data/meld_graph_scaffold/:/data,license.txt:/license.txt:ro,meld_license.txt:/meld_license.txt:ro
        export APPTAINERENV_FS_LICENSE=/license.txt
        export APPTAINERENV_MELD_LICENSE=/meld_license.txt
        RULE_TMPDIR="$(mktemp -d $TMPDIR/snakemake-apptainer.XXXXXX)"
        cleanup() {{
           rm -rf "$RULE_TMPDIR"
        }}
        trap cleanup EXIT INT TERM
        export APPTAINER_BINDPATH=$APPTAINER_BINDPATH,$RULE_TMPDIR:/tmp
        apptainer exec --containall meld_graph.sif /bin/bash -c "cd /app && python scripts/new_patient_pipeline/prepare_classifier.py"

        # drop the bundled test subject and demographics, keep meld_params/ and models/
        rm -rf data/meld_graph_scaffold/input 
        rm -rf data/meld_graph_scaffold/output
        rm -f data/meld_graph_scaffold/demographics_file.csv
        rm -f data/meld_graph_scaffold/list_subjects.txt
        rm -f data/meld_graph_scaffold/README.md

        # prepare_classifier.py aborts with exit code 0 if the data already exists, so check explicitly
        test -n "$(ls -A data/meld_graph_scaffold/meld_params/)"
        test -n "$(ls -A data/meld_graph_scaffold/models/)"

        date > {output}
        """

rule create_meld_graph_folder:
    input:
        ancient('data/meld_graph_scaffold/.download.done')
    output:
        'data/meld_graph/{site}/{B0}/.create.done'
    localrule: True
    shell:
        """
        # non-destructive: an existing input/ (subject data) and output/ (the expensive
        # FreeSurfer segmentations) are preserved, but meld_params/ and models/ will be
        # replaced with the scaffold versions
        mkdir -p data/meld_graph/{wildcards.site}/{wildcards.B0}/
        rm -rf data/meld_graph/{wildcards.site}/{wildcards.B0}/meld_params/
        rm -rf data/meld_graph/{wildcards.site}/{wildcards.B0}/models/
        cp -r data/meld_graph_scaffold/meld_params data/meld_graph_scaffold/models data/meld_graph/{wildcards.site}/{wildcards.B0}/
        date > {output}
        """

