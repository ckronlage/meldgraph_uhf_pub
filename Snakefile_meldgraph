        """

def get_subj_ids_preprocessing(wildcards):
    checkpoints.meld_graph_preprocessing.get(**wildcards).output[0]
    dir = f'data/meld_graph/{wildcards.site}/{wildcards.B0}/input/'
    return [f for f in os.listdir(dir) if f.startswith('sub-')]

