checkpoint meld_graph_preprocessing_noharmo:
    input:
        'data/meld_graph/{site}/{B0}/.segmentation.done'
    output:
        'data/meld_graph_noharmo/{site}/{B0}/.preprocessing.done'
    threads: 2
    shell:
        # copy hardlinks
        # and delete files that are modified/re-written during the noharmo run 
        # so that the original files are not changed 
        r"""
        rm -rf data/meld_graph_noharmo/{wildcards.site}/{wildcards.B0}/
        cp -rld data/meld_graph/{wildcards.site}/{wildcards.B0}/ data/meld_graph_noharmo/{wildcards.site}/{wildcards.B0}/

        rm -rf data/meld_graph_noharmo/{wildcards.site}/{wildcards.B0}/output/preprocessed_surf_data
        rm -rf data/meld_graph_noharmo/{wildcards.site}/{wildcards.B0}/output/classifier_outputs
        rm -rf data/meld_graph_noharmo/{wildcards.site}/{wildcards.B0}/output/predictions_reports
        rm -rf data/meld_graph_noharmo/{wildcards.site}/{wildcards.B0}/logs

        rm -f  data/meld_graph_noharmo/{wildcards.site}/{wildcards.B0}/.preprocessing.done
        rm -f  data/meld_graph_noharmo/{wildcards.site}/{wildcards.B0}/.prediction.done

        export APPTAINER_BINDPATH=data/meld_graph_noharmo/{wildcards.site}/{wildcards.B0}/:/data,license.txt:/license.txt:ro,meld_license.txt:/meld_license.txt:ro
        export APPTAINERENV_FS_LICENSE=/license.txt
        export APPTAINERENV_MELD_LICENSE=/meld_license.txt
        RULE_TMPDIR="$(mktemp -d $TMPDIR/snakemake-apptainer.XXXXXX)"
        cleanup() {{
           rm -rf "$RULE_TMPDIR"
        }}
        trap cleanup EXIT INT TERM
        export APPTAINER_BINDPATH=$APPTAINER_BINDPATH,$RULE_TMPDIR:/tmp
        apptainer exec --containall meld_graph.sif /bin/bash -c "cd /app && source \$FREESURFER_HOME/FreeSurferEnv.sh && python scripts/new_patient_pipeline/new_pt_pipeline.py -ids input/subjects_list.txt --skip_prediction --skip_feature_plotting"
        date > {output}
        """

