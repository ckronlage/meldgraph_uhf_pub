        export APPTAINER_BINDPATH=$APPTAINER_BINDPATH,$RULE_TMPDIR:/tmp
        apptainer exec --containall meld_graph.sif /bin/bash -c "cd /app && source \$FREESURFER_HOME/FreeSurferEnv.sh && timeout {resources.runtime}m python scripts/new_patient_pipeline/run_script_segmentation.py -id {wildcards.subj_id} --uhf_highres --threads {threads}"                                                     
